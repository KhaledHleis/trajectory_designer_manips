{
  "_comment": "Trajectory dataset generation config. All 'range' fields are [min, max] for uniform random sampling.",
  "dataset": {
    "name": "cable_survey_dataset",
    "n_trajectories": 50,
    "output_dir": "output",
    "seed": 42,
    "trajectory_types": [
      "Lawnmower",
      "Revisit"
    ],
    "trajectory_weights": null,
    "formats": [
      "csv",
      "json"
    ],
    "write_manifest": true,
    "write_label_events": true
  },
  "cable": {
    "p1": [
      48.49227909392259,
      -4.50434496199812
    ],
    "p2": [
      48.492313209033945,
      -4.503827049110521
    ],
    "randomize_position": false,
    "position_jitter_m": 0.0
  },
  "global": {
    "sampling_freq": {
      "fixed": 50.0
    },
    "drone_speed": {
      "range": [
        1.0,
        3.0
      ]
    }
  },
  "per_type": {
    "Lawnmower": {
      "n_crossings": {
        "range": [
          3,
          12
        ],
        "dtype": "int"
      },
      "angle_deg": {
        "range": [
          20,
          160
        ]
      },
      "pass_width": {
        "range": [
          0.4,
          1.2
        ]
      }
    },
    "Revisit": {
      "offset_m": {
        "range": [
          2.0,
          15.0
        ]
      },
      "overshoot_m": {
        "range": [
          2.0,
          10.0
        ]
      },
      "start_side": {
        "choice": [
          1,
          -1
        ]
      }
    }
  }
}